LISTEN_ADDRESS=0.0.0.0:8080
API_SECRET=replace-with-a-long-random-secret
DATA_DIRECTORY=/var/lib/cfx-escrow-service
SOURCE_REPOSITORY=example-org/fivem-server
SOURCE_REPOSITORY_URL=https://github.com/example-org/fivem-server.git
ADDITIONAL_REPOSITORIES_JSON={}
SOURCE_BRANCH=main
RESOURCE_ROOT=server-files/resources
UPLOADER_BINARY=node
UPLOADER_ARGS_JSON=["/opt/cfx-escrow-bot/src/cli-escrow.js"]
CFX_FORUM_COOKIE=replace-with-forum-cookie
MIRROR_REPOSITORY=example-org/fivem-server-escrowed
MIRROR_BRANCH=main
MIRROR_TOKEN=replace-with-fine-grained-token
GIT_AUTHOR_NAME=cfx-escrow-service
GIT_AUTHOR_EMAIL=cfx-escrow-service@users.noreply.github.com
JOB_TIMEOUT=3h
MAX_BODY_BYTES=1048576
